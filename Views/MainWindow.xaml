<Window x:Class="AresLitho.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:AresLitho"
        xmlns:vm="clr-namespace:AresLitho.ViewModels"
        xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
        mc:Ignorable="d"
        Title="AresLitho" Height="450" Width="800">
    <Window.DataContext>
        <vm:MainViewModel/>
    </Window.DataContext>
    <DockPanel>
        <Menu DockPanel.Dock="Top">
            <MenuItem Header="ファイル">
                <MenuItem Header="開く"/>
                <Separator/>
                <MenuItem Header="書き出し" Command="{ Binding WriteGoo }"/>
            </MenuItem>
            <MenuItem Header="設定">

            </MenuItem>
        </Menu>

        <Grid Name="DropArea"
            Background="Transparent"
              xmlns:drBehavior="clr-namespace:AresLitho.Behaviors">
            <i:Interaction.Behaviors>
                <drBehavior:BackgroundDropCommandBehavior Command="{Binding DropCommand}"/>
            </i:Interaction.Behaviors>

            <DockPanel>
                <Grid DockPanel.Dock="Right" Width="200">
                    <Grid.RowDefinitions>
                        <RowDefinition/>
                        <RowDefinition/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0">
                        <TextBlock Text="オブジェクト"/>
                        <ListBox
                            ItemsSource="{Binding ImportedFiles}"
                            SelectedItem="{Binding SelectedImportedFile}">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding FileName}"/>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                            <ListBox.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Header="削除"/>
                                </ContextMenu>
                            </ListBox.ContextMenu>
                        </ListBox>
                    </StackPanel>

                    <StackPanel Grid.Row="1">
                        <TextBlock Text="プロパティ"/>
                        <ListBox ItemsSource="{Binding SelectedProperties}">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding Name}" Width="75"/>
                                        <Separator/>
                                        <TextBox Text="{Binding Value}"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </StackPanel>
                </Grid>
                <Grid>
                    <Image Source="{Binding Bitmap}"/>
                </Grid>
            </DockPanel>
        </Grid>
    </DockPanel>
</Window>
